{
  "name": "hycbox-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:games && vite",
    "build": "npm run build:games && vite build",
    "build:games": "node games/build-games.mjs",
    "build:trial": "npm run build:games && vite build --mode trial",
    "build:v2": "npm run build:games && vite build --mode v2",
    "preview": "vite preview",
    "deploy": "node deploy/deploy-web.cjs",
    "deploy:trial": "node deploy/deploy-web.cjs --trial",
    "deploy:v2": "node deploy/deploy-web.cjs --v2"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "lil-gui": "^0.21.0",
    "maplibre-gl": "^4.7.1",
    "three": "^0.184.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.0",
    "ssh2": "^1.16.0",
    "vite": "^6.0.7"
  }
}
